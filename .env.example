# Copy this file to .env.local and fill in your values. Never commit real keys.

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Never expose this in client code.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: overrides the auth redirect URL used on the signup form (local development).
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=

# --- Upstash Redis (required for rate limiting) ---
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- AI and voice providers (add the ones you use) ---
GROQ_API_KEY=
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=

# --- Telephony and real-time audio (optional) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Email (optional) ---
RESEND_API_KEY=
